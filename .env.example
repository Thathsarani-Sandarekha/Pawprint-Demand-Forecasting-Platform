APP_ENV=development
# Docker PostgreSQL is bound to 127.0.0.1:5433 to avoid port 5432 conflicts.
# Local development only. Choose a different password for any non-local environment.
POSTGRES_PASSWORD=local_dev_only_change_me
DATABASE_URL=postgresql+psycopg://pet_forecast:local_dev_only_change_me@127.0.0.1:5433/pet_forecast

# Optional container connection (inside Compose, not the Windows host).
# Set this to match POSTGRES_PASSWORD if you changed it; URL-encode special characters.
DOCKER_DATABASE_URL=postgresql+psycopg://pet_forecast:local_dev_only_change_me@postgres:5432/pet_forecast
# Optional tracking and cloud integrations (CLI flags/standard AWS credential chain).
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# AWS_REGION=us-east-1
